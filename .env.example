# 🔴 required    🟡 recommended    ⚪ optional (has a default)

# ===================== App =====================
# 🔴
NODE_ENV=production
# 🔴 the frontend's exact address, comma separated; not "*" (login sessions need it)
CORS_ORIGINS=https://app.firmli.com
# 🔴 proxies in front of the app: 1 behind one load balancer, 0 without one
TRUST_PROXY=1
# ⚪
PORT=5000
LOG_LEVEL=info

# ============ Login and sessions ============
# 🔴 32+ random characters, different per environment. Make one:
#    node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# ⚪
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30
# ⚪ lax = frontend and API on the same site; none = different sites (https only)
COOKIE_SAME_SITE=lax
COOKIE_SECURE=true
# ⚪ e.g. .firmli.com to share the cookie between subdomains
COOKIE_DOMAIN=

# ================== Database ==================
# 🔴
FIRMLI_DB_HOST=
FIRMLI_DB_USER=
FIRMLI_DB_PASSWORD=
FIRMLI_DB_DATABASE=
# ⚪
FIRMLI_DB_PORT=3306
FIRMLI_DB_DIALECT=mysql
FIRMLI_DB_POOL_MAX=10

# ================== Frontend ==================
# 🔴 used for the links in emails
FRONTEND_URL=https://app.firmli.com

# =============== File storage (S3) ===============
# 🔴
S3_BUCKET=
# 🔴 unless the server has an IAM role
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# ⚪
AWS_REGION=ap-south-1
S3_KEY_PREFIX=production/
S3_DOWNLOAD_URL_EXPIRES_IN=300
# ⚪ only for MinIO / S3-compatible storage
S3_ENDPOINT=

# ============== Job queue (Redis) ==============
# 🟡 e.g. redis://<host>:6379/1 (empty = AI runs inside the API, without retries)
REDIS_URL=
# ⚪
QUEUE_PREFIX=firmli-production
QUEUE_CONCURRENCY=3
QUEUE_WORKER=true

# =============== Email (SMTP) ===============
# 🔴 empty = no emails
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
# ⚪ empty = 587, false, "Firmli <no-reply@firmli.com>"
SMTP_PORT=
SMTP_SECURE=
MAIL_FROM=

# ===================== AI =====================
# ⚪ empty = OpenAI itself
OPENAI_BASE_URL=

# ================= Encryption =================
# 🔴 64 hex characters; encrypts each institution's OpenAI key and SMTP password; never change it once keys are saved. Make one:
#    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
