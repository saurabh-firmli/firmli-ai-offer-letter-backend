NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# "*" = any origin, no cookies. For cookies list the origins:
# CORS_ORIGINS=http://localhost:5173,https://app.firmli.com
CORS_ORIGINS=*
# true when running behind a load balancer / reverse proxy
TRUST_PROXY=false

# MySQL (leave FIRMLI_DB_HOST empty to boot without a database)
FIRMLI_DB_HOST=
FIRMLI_DB_USER=
FIRMLI_DB_PASSWORD=
FIRMLI_DB_DATABASE=
FIRMLI_DB_PORT=3306
FIRMLI_DB_DIALECT=mysql
